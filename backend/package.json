{
  "name": "jobapply-ai-backend",
  "version": "1.0.0",
  "description": "Backend server for JobApply AI - automated job application system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --exec \"node --dns-result-order=ipv4first server.js\" --ignore \"resumes/\" --ignore \"generated-resumes/\" --ignore \"data/\"",
    "test": "node --test tests/multiTenant.test.js tests/keywordHighlighter.test.js",
    "migrate:legacy-user": "node scripts/migrateLegacyUser.js"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.104.1",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "firebase-admin": "^13.8.0",
    "googleapis": "^144.0.0",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.2.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
